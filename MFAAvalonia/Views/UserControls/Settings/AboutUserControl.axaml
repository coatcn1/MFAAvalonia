<?xml version="1.0" encoding="UTF-8" ?>
<UserControl d:DesignHeight="450" d:DesignWidth="800" mc:Ignorable="d"
             x:DataType="pages:SettingsViewModel"
             x:Class="MFAAvalonia.Views.UserControls.Settings.AboutUserControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helper="clr-namespace:MFAAvalonia.Helper"
             xmlns:markup="https://codewf.com"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:MFAAvalonia.ViewModels.Pages"
             xmlns:full="https://github.com/whistyun/Markdown.Avalonia"
             xmlns:extensions="clr-namespace:MFAAvalonia.Extensions"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent.Markup;assembly=FluentIcons.Avalonia.Fluent">
    <StackPanel Spacing="10">
        <!-- 项目资料集中在一张卡片中，避免 Logo、介绍和联系信息被拆散。 -->
        <suki:GlassCard Padding="28,24" IsVisible="{Binding HasResourceProjectInfo}">
            <StackPanel Spacing="18">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <!-- 放大 About 专用人物图，同时裁掉原图外围留白，不修改源素材。 -->
                    <suki:GlassCard Width="200" Height="200" HorizontalAlignment="Center" ClipToBounds="True"
                                    Classes="Control" CornerRadius="18" IsAnimated="False"
                                    IsVisible="{Binding HasResourceIcon}">
                        <Image Source="{Binding ResourceIcon}" Stretch="UniformToFill" RenderTransformOrigin="50%,50%">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1.17" ScaleY="1.17" />
                                    <TranslateTransform X="-4" />
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </suki:GlassCard>
                    <TextBlock Text="{Binding ResourceProjectName}" HorizontalAlignment="Center"
                               FontSize="24" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Text="{Binding ResourceDescription}" HorizontalAlignment="Center" MaxWidth="620"
                           FontSize="15" LineHeight="23" Opacity="0.82" TextAlignment="Center" TextWrapping="Wrap"
                           IsVisible="{Binding HasResourceDescription}" />

                <suki:GlassCard Padding="16,12" Classes="Control" CornerRadius="10" IsAnimated="False"
                                IsVisible="{Binding HasResourceContact}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <ContentControl Content="{fluent:FluentIcon Icon=ContactCard, IconSize=Size20}" />
                            <TextBlock Text="{markup:I18n {x:Static helper:LangKeys.ContactInfo}}"
                                       FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <full:MarkdownScrollViewer Markdown="{Binding ResourceContact}" Margin="29,0,0,0">
                            <full:MarkdownScrollViewer.Engine><extensions:MarkdownExtension /></full:MarkdownScrollViewer.Engine>
                            <full:MarkdownScrollViewer.Plugins><StaticResource ResourceKey="MdXamlPlugin" /></full:MarkdownScrollViewer.Plugins>
                            <full:MarkdownScrollViewer.Styles><StyleInclude Source="avares://MFAAvalonia.Core/Assets/Style/MdXamlStyles.axaml" /></full:MarkdownScrollViewer.Styles>
                        </full:MarkdownScrollViewer>
                    </StackPanel>
                </suki:GlassCard>

                <suki:GlassCard Padding="16,12" Classes="Control" CornerRadius="10" IsAnimated="False"
                                IsVisible="{Binding HasResourceLicense}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <ContentControl Content="{fluent:FluentIcon Icon=Certificate, IconSize=Size20}" />
                            <TextBlock Text="{markup:I18n {x:Static helper:LangKeys.LicenseInfo}}"
                                       FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <full:MarkdownScrollViewer Markdown="{Binding ResourceLicense}" Margin="29,0,0,0">
                            <full:MarkdownScrollViewer.Engine><extensions:MarkdownExtension /></full:MarkdownScrollViewer.Engine>
                            <full:MarkdownScrollViewer.Plugins><StaticResource ResourceKey="MdXamlPlugin" /></full:MarkdownScrollViewer.Plugins>
                            <full:MarkdownScrollViewer.Styles><StyleInclude Source="avares://MFAAvalonia.Core/Assets/Style/MdXamlStyles.axaml" /></full:MarkdownScrollViewer.Styles>
                        </full:MarkdownScrollViewer>
                    </StackPanel>
                </suki:GlassCard>

                <Border Padding="0,14,0,0">
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Opacity="0.62"
                               Text="Powered by MaaFramework &amp; MFAAvalonia" />
                </Border>
            </StackPanel>
        </suki:GlassCard>

        <!-- 保留原有维护入口，不和项目主体信息混排。 -->
        <suki:GlassCard Padding="25,8,25,8">
            <DockPanel>
                <Button BorderBrush="Transparent" BorderThickness="0" Click="DisplayAnnouncement"
                        Content="{fluent:FluentIcon Icon=Send, IconSize=Size16}" DockPanel.Dock="Right"
                        Height="40" HorizontalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock FontSize="16" FontWeight="SemiBold"
                           Text="{markup:I18n {x:Static helper:LangKeys.DisplayAnnouncement}}" VerticalAlignment="Center" />
            </DockPanel>
        </suki:GlassCard>
        <suki:GlassCard Padding="25,8,25,8">
            <DockPanel>
                <Button BorderBrush="Transparent" BorderThickness="0" Click="ClearCache_Click"
                        Content="{fluent:FluentIcon Icon=Send, IconSize=Size16}" DockPanel.Dock="Right"
                        Height="40" HorizontalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock FontSize="16" FontWeight="SemiBold"
                           Text="{markup:I18n {x:Static helper:LangKeys.ClearCache}}" VerticalAlignment="Center" />
            </DockPanel>
        </suki:GlassCard>
        <suki:GlassCard Padding="25,8,25,8">
            <DockPanel>
                <Button BorderBrush="Transparent" BorderThickness="0" Click="Button_OnClick"
                        Content="{fluent:FluentIcon Icon=Send, IconSize=Size16}" DockPanel.Dock="Right"
                        Height="40" HorizontalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock FontSize="16" FontWeight="SemiBold"
                           Text="{markup:I18n {x:Static helper:LangKeys.ExportLog}}" VerticalAlignment="Center" />
            </DockPanel>
        </suki:GlassCard>
        <suki:GlassCard Padding="25,8,25,8" Name="TutorialCard">
            <DockPanel>
                <Button BorderBrush="Transparent" BorderThickness="0" Click="StartTutorial_Click"
                        Content="{fluent:FluentIcon Icon=Send, IconSize=Size16}" DockPanel.Dock="Right"
                        Height="40" HorizontalAlignment="Center" Margin="0,0,4,0" />
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <ContentControl Content="{fluent:FluentIcon Icon=Lightbulb, IconSize=Size20}" />
                    <TextBlock FontSize="16" FontWeight="SemiBold"
                               Text="{markup:I18n {x:Static helper:LangKeys.Tutorial}}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </suki:GlassCard>
    </StackPanel>
</UserControl>
