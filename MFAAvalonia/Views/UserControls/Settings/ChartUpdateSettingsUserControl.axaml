<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:settings="clr-namespace:MFAAvalonia.ViewModels.UsersControls.Settings" xmlns:suki="https://github.com/kikipoulet/SukiUI" x:Class="MFAAvalonia.Views.UserControls.Settings.ChartUpdateSettingsUserControl" x:DataType="settings:PerformanceProfileSettingsUserControlModel">
  <suki:GlassCard Margin="0,15,0,0" Padding="20">
    <StackPanel Spacing="14">
      <TextBlock Text="谱面更新" FontSize="20" FontWeight="DemiBold"/>
      <Button Content="刷新" Command="{Binding RefreshCommand}" HorizontalAlignment="Left"/>
      <TextBlock Text="Bestdori 本地数据" FontSize="16" FontWeight="DemiBold"/>
      <TextBlock Text="{Binding ChartCatalogText}" TextWrapping="Wrap"/>
      <DockPanel>
        <ToggleSwitch Classes="Switch" DockPanel.Dock="Right" IsChecked="{Binding BestdoriAutoUpdateEnabled, Mode=TwoWay}"/>
        <TextBlock Text="自动增量更新 Bestdori 谱面" VerticalAlignment="Center"/>
      </DockPanel>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="检查间隔（小时）" VerticalAlignment="Center"/>
        <NumericUpDown Value="{Binding BestdoriAutoUpdateIntervalHours, Mode=TwoWay}" Minimum="1" Maximum="720" Increment="1" Width="100"/>
      </StackPanel>
      <TextBlock Text="默认每 24 小时，仅在全部实例任务结束后检查；演出期间不更新，关闭后停止自动同步。" TextWrapping="Wrap" Opacity="0.75"/>
      <TextBlock Text="{Binding BestdoriSyncStatus}" TextWrapping="Wrap" Opacity="0.8"/>
      <Button Content="同步/更新全部谱面（Hard / Expert / Special）" Command="{Binding SyncBestdoriChartsCommand}" HorizontalAlignment="Left"/>
      <TextBlock Text="请先停止正在运行的演奏任务。同步时优先下载 CN 封面，缺失时回退 JP/EN；已校验文件会直接复用。" TextWrapping="Wrap" Opacity="0.75"/>
      <TextBlock Text="修改后自动保存。" Opacity="0.75"/>
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Opacity="0.8"/>
    </StackPanel>
  </suki:GlassCard>
</UserControl>
