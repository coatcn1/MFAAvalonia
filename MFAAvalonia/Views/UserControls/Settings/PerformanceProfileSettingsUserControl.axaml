<UserControl x:Class="MFAAvalonia.Views.UserControls.Settings.PerformanceProfileSettingsUserControl"
             x:DataType="settings:PerformanceProfileSettingsUserControlModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:MFAAvalonia.ViewModels.UsersControls.Settings"
             xmlns:suki="https://github.com/kikipoulet/SukiUI">
  <suki:GlassCard Margin="0,15,0,0" Padding="20">
    <StackPanel Spacing="12">
      <TextBlock Text="演出设置" FontSize="20" FontWeight="DemiBold" />
      <TabControl>
        <TabItem Header="实时演奏 Profile">
          <StackPanel Spacing="12" Margin="0,12,0,0">
            <TextBlock Text="高难度 Profile 可兼容较低难度；Expert 与 Special 视为同一兼容等级。" Opacity="0.75" />
            <TextBlock Text="Expert / Special 建议把游戏内音符流速设为 5.0 或更高；流速过低会让相邻音符完全遮挡，超出图像拆分能力。"
                       TextWrapping="Wrap" Opacity="0.75" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="任务难度" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding Difficulties}" SelectedItem="{Binding Difficulty}" Width="130" />
              <Button Content="刷新" Command="{Binding RefreshCommand}" />
            </StackPanel>
            <TextBlock Text="单击行查看或编辑参数；双击行把该 Profile 设为当前任务难度的选择。"
                       TextWrapping="Wrap" Opacity="0.75" />
            <TextBlock Text="{Binding SelectionText}" TextWrapping="Wrap" FontWeight="DemiBold" />
            <DataGrid x:Name="ProfilesGrid" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserResizeColumns="True" CanUserReorderColumns="False"
                      Height="230" FontSize="14" RowHeight="32"
                      GridLinesVisibility="Horizontal" DoubleTapped="ProfilesGrid_OnDoubleTapped">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="状态" Width="96">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="settings:PerformanceProfileItem">
                      <Border IsVisible="{Binding IsCurrentSelection}"
                              Background="{DynamicResource SukiPrimaryColor15}"
                              CornerRadius="5" Padding="8,2" HorizontalAlignment="Left">
                        <TextBlock Text="当前选择" FontSize="12" FontWeight="DemiBold"
                                   Foreground="{DynamicResource SukiPrimaryColor}" />
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="文件名" Width="220" MinWidth="120">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="settings:PerformanceProfileItem">
                      <TextBlock Text="{Binding Filename}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="校准难度">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="settings:PerformanceProfileItem">
                      <TextBlock Text="{Binding Difficulty}" FontSize="13" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="验收">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="settings:PerformanceProfileItem">
                      <TextBlock Text="{Binding AcceptedText}" FontSize="13" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="引擎" Width="80">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="settings:PerformanceProfileItem">
                      <TextBlock Text="{Binding EngineText}" FontSize="13" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="环境">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="settings:PerformanceProfileItem">
                      <TextBlock Text="{Binding EnvironmentMatchText}" FontSize="13" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="流速" Width="90">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="settings:PerformanceProfileItem">
                      <TextBlock Text="{Binding NoteSpeedText}" FontSize="13" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="修改时间" Width="180">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="settings:PerformanceProfileItem">
                      <TextBlock Text="{Binding ModifiedAt}" FontSize="13" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding SelectedProfile.EnvironmentText}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,110,20,Auto,110" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="目标 FPS (15–240)" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding TargetFps, Mode=TwoWay}" Minimum="15" Maximum="240" />
              <TextBlock Grid.Row="0" Grid.Column="3" Text="时序偏移 ms (-250–250)" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="0" Grid.Column="4" Value="{Binding TimingOffsetMs, Mode=TwoWay}" Minimum="-250" Maximum="250" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="帧超时 ms (50–5000)" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding FrameTimeoutMs, Mode=TwoWay}" Minimum="50" Maximum="5000" />
              <TextBlock Grid.Row="1" Grid.Column="3" Text="演奏区超时 ms (≤10000)" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="1" Grid.Column="4" Value="{Binding PlayfieldTimeoutMs, Mode=TwoWay}" Minimum="50" Maximum="10000" />
            </Grid>
            <TextBlock Text="修改后自动保存；修改已验收 Profile 时会先确认并撤销验收。"
                       TextWrapping="Wrap" Opacity="0.75" />
            <TextBlock Text="校准记录" FontSize="16" FontWeight="DemiBold" />
            <TextBlock Text="{Binding SelectedProfile.CalibrationRecordsText}" TextWrapping="Wrap" />
          </StackPanel>
        </TabItem>

        <TabItem Header="谱面辅助">
          <StackPanel Spacing="14" Margin="0,12,0,0">
            <TextBlock Text="本地谱面与主时钟" FontSize="18" FontWeight="DemiBold" />
            <TextBlock Text="只读取已部署到本机、且歌曲指纹、难度和哈希完全匹配的 Bestdori 谱面；开演时不会联网。"
                       TextWrapping="Wrap" Opacity="0.75" />
            <DockPanel>
              <ToggleSwitch Classes="Switch" DockPanel.Dock="Right"
                            IsChecked="{Binding ChartPredictionEnabled, Mode=TwoWay}" />
              <TextBlock Text="启用本地谱面辅助" VerticalAlignment="Center" />
            </DockPanel>
            <DockPanel>
              <ToggleSwitch Classes="Switch" DockPanel.Dock="Right"
                            IsChecked="{Binding ChartPredictPresses, Mode=TwoWay}" />
              <TextBlock Text="谱面主时钟（锁相后由谱面派发触控）" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="谱面缺失、初始锁相不可信或连续漂移超限时自动回退视觉演奏；修改其他演出设置不会清除这两个开关。"
                       TextWrapping="Wrap" Opacity="0.75" />
            <Separator Margin="0,4" />
            <TextBlock Text="Native C++ 演奏核心" FontSize="16" FontWeight="DemiBold" />
            <DockPanel>
              <ToggleSwitch Classes="Switch" DockPanel.Dock="Right"
                            IsChecked="{Binding NativeRealtimeEnabled, Mode=TwoWay}" />
              <TextBlock Text="启用 Native C++ 演奏核心（测试）" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="默认关闭；开启后由 Native 从第一音符开始独占触控，故障时安全终止且不会中途回退 Legacy。只建议用于固定歌曲验收。"
                       TextWrapping="Wrap" Opacity="0.75" />
            <DockPanel>
              <ToggleSwitch Classes="Switch" DockPanel.Dock="Right"
                            IsChecked="{Binding NativeLifeFeedbackEnabled, Mode=TwoWay}" />
              <TextBlock Text="Native 掉血判定纠偏（实验）" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="默认关闭；仅 Native 正式演奏在持续掉血时短暂采集 FAST/SLOW，并在安全空档纠偏未来输入。排练、校准和 Legacy 不使用。"
                       TextWrapping="Wrap" Opacity="0.75" />
            <DockPanel>
              <ToggleSwitch Classes="Switch" DockPanel.Dock="Right"
                            IsChecked="{Binding NativeWaitJitterFilterEnabled, Mode=TwoWay}" />
              <TextBlock Text="Native 等待抖动过滤（实验）" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="默认关闭；过滤偶发等待延迟尖峰。本局准备时冻结两个实验开关，下局生效；关闭 Native 仍保留选择。"
                       TextWrapping="Wrap" Opacity="0.75" />
            <DockPanel>
              <ToggleSwitch Classes="Switch" DockPanel.Dock="Right"
                            IsChecked="{Binding CooperativeJitterEnabled, Mode=TwoWay}" />
              <TextBlock Text="协力演出漏键抖动（避免连续全 PERFECT 被判异常）" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="仅 Native 协力生效：每局确定性随机漏掉 1~2 个普通单点（首音保留），落点每局不同；关闭后正常按谱面全连。"
                       TextWrapping="Wrap" Opacity="0.75" />
            <Separator Margin="0,4" />
            <TextBlock Text="Bestdori 本地数据" FontSize="16" FontWeight="DemiBold" />
            <TextBlock Text="{Binding ChartCatalogText}" TextWrapping="Wrap" />
            <DockPanel>
              <ToggleSwitch Classes="Switch" DockPanel.Dock="Right"
                            IsChecked="{Binding BestdoriAutoUpdateEnabled, Mode=TwoWay}" />
              <TextBlock Text="自动增量更新 Bestdori 谱面" VerticalAlignment="Center" />
            </DockPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="检查间隔（小时）" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding BestdoriAutoUpdateIntervalHours, Mode=TwoWay}"
                             Minimum="1" Maximum="720" Increment="1" Width="100" />
            </StackPanel>
            <TextBlock Text="默认每 24 小时，仅在全部实例任务结束后检查；演出期间不更新，关闭后停止自动同步。"
                       TextWrapping="Wrap" Opacity="0.75" />
            <TextBlock Text="{Binding BestdoriSyncStatus}" TextWrapping="Wrap" Opacity="0.8" />
            <Button Content="同步/更新全部谱面（Hard / Expert / Special）"
                    Command="{Binding SyncBestdoriChartsCommand}"
                    HorizontalAlignment="Left" />
            <TextBlock Text="请先停止正在运行的演奏任务。同步时优先下载 CN 封面，缺失时回退 JP/EN；已校验文件会直接复用。"
                       TextWrapping="Wrap" Opacity="0.75" />
            <TextBlock Text="修改后自动保存。" Opacity="0.75" />
          </StackPanel>
        </TabItem>

        <TabItem Header="流速">
          <StackPanel Spacing="14" Margin="0,12,0,0">
            <TextBlock Text="游戏内音符流速" FontSize="18" FontWeight="DemiBold" />
            <TextBlock Text="开启后，任务从主页进入“选项”，只读取、修正并复核音符流速；其他游戏内演出设置由用户按 README 手动配置。"
                       TextWrapping="Wrap" Opacity="0.75" />
            <DockPanel>
              <ToggleSwitch Classes="Switch" DockPanel.Dock="Right"
                            IsChecked="{Binding NoteSpeedSettingsEnabled, Mode=TwoWay}" />
              <TextBlock Text="开演前自动设置并验证流速（关闭后完全跳过并信任下方目标值）" VerticalAlignment="Center" />
            </DockPanel>
            <Separator Margin="0,4" />
            <TextBlock Text="每难度校准流速" FontSize="16" FontWeight="DemiBold" />
            <TextBlock Text="每个 Profile 固定一种流速；同一次校准期间不会自动改变。开演前会读取游戏内实际值，不一致时自动修正并复核。"
                       TextWrapping="Wrap" Opacity="0.75" />
            <Grid ColumnDefinitions="Auto,110,24,Auto,110" RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="8" RowSpacing="10">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Easy" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding EasyCalibrationSpeed, Mode=TwoWay}"
                             Minimum="1" Maximum="12" Increment="0.01" FormatString="F2" />
              <TextBlock Grid.Row="0" Grid.Column="3" Text="Normal" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="0" Grid.Column="4" Value="{Binding NormalCalibrationSpeed, Mode=TwoWay}"
                             Minimum="1" Maximum="12" Increment="0.01" FormatString="F2" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Hard" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding HardCalibrationSpeed, Mode=TwoWay}"
                             Minimum="1" Maximum="12" Increment="0.01" FormatString="F2" />
              <TextBlock Grid.Row="1" Grid.Column="3" Text="Expert" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="1" Grid.Column="4" Value="{Binding ExpertCalibrationSpeed, Mode=TwoWay}"
                             Minimum="1" Maximum="12" Increment="0.01" FormatString="F2" />
              <TextBlock Grid.Row="2" Grid.Column="0" Text="Special" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding SpecialCalibrationSpeed, Mode=TwoWay}"
                             Minimum="1" Maximum="12" Increment="0.01" FormatString="F2" />
            </Grid>
            <TextBlock Text="修改后自动保存。" Opacity="0.75" />
          </StackPanel>
        </TabItem>

        <TabItem Header="调试目录">
          <StackPanel Spacing="10" Margin="0,12,0,0">
            <TextBlock Text="调试与结果目录" FontSize="18" FontWeight="DemiBold" />
            <TextBlock Text="以下路径由部署脚本生成，不会写入仓库。" Opacity="0.75" />
            <ItemsControl ItemsSource="{Binding ArtifactLocations}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="settings:ArtifactLocationItem">
                  <Grid ColumnDefinitions="170,*,70,155,70,70" ColumnSpacing="8" Margin="0,3">
                    <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" ToolTip.Tip="{Binding Path}" />
                    <TextBlock Grid.Column="2" Text="{Binding ExistsText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding LastUpdated}" VerticalAlignment="Center" />
                    <Button Grid.Column="4" Content="复制"
                            Command="{Binding $parent[ItemsControl].((settings:PerformanceProfileSettingsUserControlModel)DataContext).CopyPathCommand}"
                            CommandParameter="{Binding}" />
                    <Button Grid.Column="5" Content="打开"
                            Command="{Binding $parent[ItemsControl].((settings:PerformanceProfileSettingsUserControlModel)DataContext).OpenDirectoryCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </TabItem>

        <TabItem Header="任务安全">
          <StackPanel Spacing="14" Margin="0,12,0,0">
            <TextBlock Text="任务安全" FontSize="18" FontWeight="DemiBold" />
            <DockPanel>
              <ToggleSwitch Classes="Switch" DockPanel.Dock="Right"
                            IsChecked="{Binding CooperativeMemberLoadingGuardEnabled, Mode=TwoWay}" />
              <TextBlock Text="协力成员加载页保护" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="默认开启；成员加载页表情图标仍在时，不确认最终歌曲封面。对协力 Native 与 Legacy 均有效；修改后自动保存，在下次任务启动时生效。"
                       TextWrapping="Wrap" Opacity="0.75" />
            <DockPanel>
              <ToggleSwitch Classes="Switch" DockPanel.Dock="Right"
                            IsChecked="{Binding SkipResultCheck, Mode=TwoWay}" />
              <TextBlock Text="不检查结果" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="开启后，其他演出结束仍会按安全节拍推进页面，但不读取或记录 PGGBM 判定数字；实时校准必须读取判定数字验收 Profile，不适用此开关。生命归零和手动停止仍按原流程处理。"
                       TextWrapping="Wrap" Opacity="0.75" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="单局技术失败重试次数" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding PlayFailureRetryCount, Mode=TwoWay}"
                             Minimum="0" Maximum="99" Width="90" />
              <TextBlock Text="用于普通单人、校准、协力与组曲；组曲失败会重演完整三首"
                         VerticalAlignment="Center" Opacity="0.75" />
            </StackPanel>
            <TextBlock Text="任务启动时最多用 30 秒检测其他程序占用。默认首次警告，再次运行时尝试清理。"
                       TextWrapping="Wrap" Opacity="0.75" />
            <DockPanel>
              <ToggleSwitch Classes="Switch" DockPanel.Dock="Right"
                            IsChecked="{Binding SkipProcessConflictCleanup, Mode=TwoWay}" />
              <TextBlock Text="跳过其他程序进程占用清理" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="开启后仍执行占用检测；发现占用或检测超时时仅显示通用警告并继续任务，绝不终止其他进程。"
                       TextWrapping="Wrap" Opacity="0.75" />
            <TextBlock Text="修改后自动保存。" Opacity="0.75" />
          </StackPanel>
        </TabItem>
      </TabControl>
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Opacity="0.8" />
    </StackPanel>
  </suki:GlassCard>
</UserControl>
